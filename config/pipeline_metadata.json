{
    "pipeline": {
        "name": "incremental_batch_pipeline",
        "type": "incremental_batch",
        "version": "1.0.0",
        "description": "Enterprise Metadata-Driven Incremental Batch Pipeline"
    },
    "source": {
        "format": "csv",
        "options": {
            "header": true,
            "inferSchema": true,
            "delimiter": ","
        }
    },
    "target": {
        "format": "delta"
    },
    "paths": {
        "local": {
            "landing": "data/landing",
            "bronze": "data/bronze",
            "silver": "data/silver",
            "gold": "data/gold",
            "audit": "data/audit",
            "control": "data/control",
            "quarantine": "data/quarantine",
            "schema_history": "data/schema_history",
            "schema_changes": "data/schema_changes",
            "logs": "data/logs",
            "reports": "data/reports",
            "reconciliation": "data/reconciliation",
            "validation": "data/reports"
        },
        "databricks": {
            "catalog": "workspace",
            "schema": "default",
            "landing": "/Volumes/workspace/default/incremental_batch/landing",
            "tables": {
                "bronze": "inc_batch_bronze",
                "silver": "inc_batch_silver",
                "gold": "inc_batch_gold",
                "audit": "inc_batch_audit",
                "reconciliation": "inc_batch_reconciliation"
            },
            "audit": "/Volumes/workspace/default/incremental_batch/audit",
            "control": "/Volumes/workspace/default/incremental_batch/control",
            "quarantine": "/Volumes/workspace/default/incremental_batch/quarantine",
            "schema_history": "/Volumes/workspace/default/incremental_batch/schema_history",
            "schema_changes": "/Volumes/workspace/default/incremental_batch/schema_changes",
            "logs": "/Volumes/workspace/default/incremental_batch/logs",
            "reports": "/Volumes/workspace/default/incremental_batch/reports",
            "validation": "/Volumes/workspace/default/incremental_batch/reports"
        }
    }
}