{
    "metadata_version": "1.0.0",
    "pipeline": {
        "name": "incremental_batch_pipeline",
        "type": "incremental_batch",
        "version": "1.0.0",
        "description": "Enterprise Metadata-Driven Incremental Batch Pipeline"
    },
    "environment": {
        "supported": [
            "local",
            "databricks"
        ]
    },
    "source": {
        "format": "csv",
        "options": {
            "header": true,
            "inferSchema": true,
            "delimiter": ","
        }
    },
    "target": {
        "format": "delta"
    },
    "paths": {
        "local": {
            "base_path": "data",
            "folders": {
                "landing": "landing",
                "bronze": "bronze",
                "silver": "silver",
                "gold": "gold",
                "audit": "audit",
                "control": "control",
                "quarantine": "quarantine",
                "schema_history": "schema_history",
                "schema_changes": "schema_changes",
                "logs": "logs",
                "reports": "reports",
                "reconciliation": "reconciliation",
                "validation": "reports"
            }
        },
        "databricks": {
            "catalog": "workspace",
            "schema": "default",
            "volume": "incremental_batch",
            "folders": {
                "landing": "landing",
                "bronze": "bronze",
                "silver": "silver",
                "gold": "gold",
                "audit": "audit",
                "control": "control",
                "quarantine": "quarantine",
                "schema_history": "schema_history",
                "schema_changes": "schema_changes",
                "logs": "logs",
                "reports": "reports",
                "reconciliation": "reconciliation",
                "validation": "reports"
            },
            "tables": {
                "bronze": "inc_batch_bronze",
                "silver": "inc_batch_silver",
                "gold": "inc_batch_gold",
                "audit": "inc_batch_audit",
                "control": "inc_batch_control",
                "reconciliation": "inc_batch_reconciliation"
            },
            "storage": {
                "type": "unity_catalog_volume"
            }
        }
    }
}